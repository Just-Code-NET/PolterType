#!/bin/sh
# poltertype — pre-commit hook
#
# Refuses to record a commit if the linters would fail:
#
#   1. `cargo fmt --all -- --check`   — formatter drift
#   2. `cargo clippy … -D warnings`   — lint violations
#
# Same checks CI runs, so failing here is equivalent to failing the
# GitHub workflow — better to find out locally before pushing.
#
# Bypass (use sparingly, e.g. for an in-progress wip-style commit):
#     git commit --no-verify
#
# To install / re-install all hooks:
#     cargo xtask hooks install

set -e

# If cargo isn't on PATH the editor is probably someone working on
# docs without a Rust toolchain. Skip silently rather than blocking.
if ! command -v cargo >/dev/null 2>&1; then
    echo "poltertype pre-commit: cargo not found, skipping lint checks"
    exit 0
fi

echo "poltertype pre-commit: cargo fmt --all -- --check"
if ! cargo fmt --all -- --check; then
    echo
    echo "poltertype pre-commit: rustfmt has changes to make."
    echo "Run \`cargo fmt --all\` to fix, then re-stage and re-commit."
    echo "(or \`git commit --no-verify\` if you really need to bypass)"
    exit 1
fi

# Two clippy runs, not one, and this is the interesting part.
#
# CI lints WITHOUT `--all-features`, so the feature-off shape of an
# optional crate is a configuration nothing local ever checked. That
# is not hypothetical: the 0.10.0 AI work passed every local check and
# then failed on all three CI platforms, because the HTTP module is
# dead code when `remote` is off. Whichever set you run, run the other
# one too — the cheap one first, since it is the one CI mirrors.
echo "poltertype pre-commit: cargo clippy --workspace --all-targets -- -D warnings  (CI's set)"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo
    echo "poltertype pre-commit: clippy found problems in the DEFAULT feature set."
    echo "This is exactly what CI runs. Fix, or commit with --no-verify."
    exit 1
fi

echo "poltertype pre-commit: cargo clippy --workspace --all-targets --all-features -- -D warnings"
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo
    echo "poltertype pre-commit: clippy found problems."
    echo "Fix the warnings above, then re-stage and re-commit."
    echo "(or \`git commit --no-verify\` if you really need to bypass)"
    exit 1
fi
