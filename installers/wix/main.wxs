<?xml version="1.0" encoding="windows-1252"?>
<!--
    WiX Toolset 3.x source for the PolterType MSI.

    Built directly with `candle.exe` + `light.exe` (no cargo-wix
    wrapper) so that all parameter-substitution is explicit:

        candle  -dProductVersion=...
                -dBinPath=...
                -dLicensePath=...
                -dDataDir=...    (target/dist/data — bundled at install)
                -dIconPath=...   (optional; falls back to no icon)
                installers\wix\main.wxs -out main.wixobj
        light   main.wixobj -out poltertype.msi

    The `installers\windows\build-msi.ps1` script wraps both calls.

    UpgradeCode is *intentionally* fixed forever — it's the GUID Windows
    keys MSI upgrades off, so changing it would orphan every existing
    install. Per-component GUIDs are also fixed (see `*ComponentGuid`
    defines below) — auto-generation via `Guid="*"` is rejected by
    `CNDL0230` for components that hold BOTH a `File` AND a
    `RegistryValue` keypath, which is exactly our shape (see ICE38
    rationale below).

    perUser-install authoring rules (ICE38 / ICE43 / ICE69 / ICE19):

      * Every component installing files into the user profile MUST
        have an HKCU `RegistryValue` element marked `KeyPath="yes"`
        (NOT a `File`). The registry write is what Windows Installer
        uses to decide "is this component installed for the current
        user?". Each component needs a *distinct* registry name to
        avoid collisions.
      * A `Shortcut` whose `Target` references a file in another
        component triggers ICE69. Easiest fix: declare the shortcut
        inside the same component as the file it points at.
      * `Advertise="yes"` shortcuts require the component KeyPath to
        be a `File`. Combined with the rule above, that's an outright
        contradiction for perUser installs — so our shortcuts are
        *non-advertised* with an explicit `Target="[#ExeFile]"`.

    Data-bundle layout (matches `poltertype_core::data_dir` resolver order #2,
    "<exe_dir>/data/"):

        APPLICATIONROOTFOLDER/
          poltertype.exe
          LICENSE
          data/
            layout-mappings/   (one .toml per bundled language)
            wordlists/         (one .fst + one -stop.txt per language)

    The `data/` tree is produced by `crates/poltertype-core/build.rs` and
    written to `target/dist/data/`; the build script passes that path
    in as `$(var.DataDir)` so the File `Source=` references are
    runner-portable.
-->
<?define ProductName = "PolterType" ?>
<?define Manufacturer = "PolterType contributors" ?>
<?define UpgradeCode = "4F8B6C00-5D1E-4A3F-9B2C-1D0E2F3A4B50" ?>
<?define InstallRegKey = "Software\$(var.Manufacturer)\$(var.ProductName)" ?>

<!--
    Component GUIDs are FIXED, not auto-generated (`Guid="*"`).
    Reason: each Component below holds BOTH a `File` AND a
    `RegistryValue` with `KeyPath="yes"`. WiX's CNDL0230 rejects
    `Guid="*"` for that combination. Stable across versions on
    purpose — Windows Installer keys major upgrades off these so
    existing installs upgrade cleanly.

    Pick a fresh GUID only if you're splitting a component or
    breaking the upgrade chain on purpose.
-->
<?define MainExecutableComponentGuid    = "4F8B6C01-5D1E-4A3F-9B2C-1D0E2F3A4B51" ?>
<?define LicenseFileComponentGuid       = "4F8B6C02-5D1E-4A3F-9B2C-1D0E2F3A4B52" ?>
<?define DataLayoutMappingsComponentGuid = "4F8B6C03-5D1E-4A3F-9B2C-1D0E2F3A4B53" ?>
<?define DataWordlistsComponentGuid      = "4F8B6C04-5D1E-4A3F-9B2C-1D0E2F3A4B54" ?>
<?define DataI18nComponentGuid           = "4F8B6C05-5D1E-4A3F-9B2C-1D0E2F3A4B55" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="$(var.ProductName)"
             Language="1033"
             Codepage="1252"
             Version="$(var.ProductVersion)"
             Manufacturer="$(var.Manufacturer)"
             UpgradeCode="$(var.UpgradeCode)">

        <Package InstallerVersion="450"
                 Compressed="yes"
                 InstallScope="perUser"
                 Description="Cross-platform automatic keyboard layout switcher"
                 Manufacturer="$(var.Manufacturer)"
                 Languages="1033"
                 SummaryCodepage="1252" />

        <!--
            perUser scope: PolterType is a tray app the user launches
            themselves — no service, no scheduled task — so installing
            into the per-machine Program Files would gain nothing and
            cost a UAC prompt on every install. perUser keeps the
            install silent and contained to the current user's profile.
        -->

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
            AllowSameVersionUpgrades="yes" />

        <MediaTemplate EmbedCab="yes" />

        <!-- Optional EXE icon for Add/Remove Programs. The build
             script defines IconPath only if an .ico is provided. -->
        <?ifdef IconPath ?>
            <Icon Id="AppIcon.exe" SourceFile="$(var.IconPath)" />
            <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
        <?endif ?>

        <Property Id="ARPHELPLINK" Value="https://github.com/Just-Code-NET/poltertype" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/Just-Code-NET/poltertype" />

        <Feature Id="MainFeature"
                 Title="$(var.ProductName)"
                 Level="1"
                 ConfigurableDirectory="APPLICATIONROOTFOLDER">
            <ComponentGroupRef Id="MainComponents" />
            <ComponentRef Id="DataLayoutMappings" />
            <ComponentRef Id="DataWordlists" />
            <ComponentRef Id="DataI18n" />
        </Feature>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <!-- LocalAppDataFolder = %LOCALAPPDATA%, perUser-friendly -->
            <Directory Id="LocalAppDataFolder">
                <Directory Id="ManufacturerFolder" Name="$(var.Manufacturer)">
                    <Directory Id="APPLICATIONROOTFOLDER" Name="$(var.ProductName)">
                        <!--
                            Bundled data tree: layout TOMLs and FST
                            wordlists. Loaded at runtime by the
                            `poltertype_core::data_dir` resolver, which checks
                            `<exe_dir>/data/` first.
                        -->
                        <Directory Id="DataDir" Name="data">
                            <Directory Id="DataLayoutMappingsDir" Name="layout-mappings">
                                <Component Id="DataLayoutMappings"
                                           Guid="$(var.DataLayoutMappingsComponentGuid)">
                                    <!-- HKCU KeyPath required by ICE38
                                         for perUser; one per Component. -->
                                    <RegistryValue Root="HKCU"
                                                   Key="$(var.InstallRegKey)"
                                                   Name="DataLayoutMappings"
                                                   Type="integer"
                                                   Value="1"
                                                   KeyPath="yes" />
                                    <File Id="MapEnUs"
                                          Source="$(var.DataDir)\layout-mappings\en_us.toml"
                                          Name="en_us.toml" />
                                    <File Id="MapUkUa"
                                          Source="$(var.DataDir)\layout-mappings\uk_ua.toml"
                                          Name="uk_ua.toml" />
                                    <File Id="MapRuRu"
                                          Source="$(var.DataDir)\layout-mappings\ru_ru.toml"
                                          Name="ru_ru.toml" />
                                    <File Id="MapDeDe"
                                          Source="$(var.DataDir)\layout-mappings\de_de.toml"
                                          Name="de_de.toml" />
                                    <File Id="MapEsEs"
                                          Source="$(var.DataDir)\layout-mappings\es_es.toml"
                                          Name="es_es.toml" />
                                    <File Id="MapFrFr"
                                          Source="$(var.DataDir)\layout-mappings\fr_fr.toml"
                                          Name="fr_fr.toml" />
                                    <File Id="MapPlPl"
                                          Source="$(var.DataDir)\layout-mappings\pl_pl.toml"
                                          Name="pl_pl.toml" />
                                    <File Id="MapCsCz"
                                          Source="$(var.DataDir)\layout-mappings\cs_cz.toml"
                                          Name="cs_cz.toml" />
                                    <File Id="MapElGr"
                                          Source="$(var.DataDir)\layout-mappings\el_gr.toml"
                                          Name="el_gr.toml" />
                                    <File Id="MapHeIl"
                                          Source="$(var.DataDir)\layout-mappings\he_il.toml"
                                          Name="he_il.toml" />
                                    <File Id="MapTrTr"
                                          Source="$(var.DataDir)\layout-mappings\tr_tr.toml"
                                          Name="tr_tr.toml" />
                                    <File Id="MapBgBg"
                                          Source="$(var.DataDir)\layout-mappings\bg_bg.toml"
                                          Name="bg_bg.toml" />
                                    <File Id="MapItIt"
                                          Source="$(var.DataDir)\layout-mappings\it_it.toml"
                                          Name="it_it.toml" />
                                    <File Id="MapPtPt"
                                          Source="$(var.DataDir)\layout-mappings\pt_pt.toml"
                                          Name="pt_pt.toml" />
                                    <File Id="MapPtBr"
                                          Source="$(var.DataDir)\layout-mappings\pt_br.toml"
                                          Name="pt_br.toml" />
                                    <RemoveFolder Id="RemoveDataLayoutMappingsDir"
                                                  Directory="DataLayoutMappingsDir"
                                                  On="uninstall" />
                                </Component>
                            </Directory>
                            <Directory Id="DataI18nDir" Name="i18n">
                                <Component Id="DataI18n"
                                           Guid="$(var.DataI18nComponentGuid)">
                                    <RegistryValue Root="HKCU"
                                                   Key="$(var.InstallRegKey)"
                                                   Name="DataI18n"
                                                   Type="integer"
                                                   Value="1"
                                                   KeyPath="yes" />
                                    <!-- UI translations. English is compiled
                                         into every call site, so a missing
                                         catalog costs nothing. -->
                                    <File Id="I18nUk"
                                          Source="$(var.DataDir)\i18n\uk.toml"
                                          Name="uk.toml" />
                                    <RemoveFolder Id="RemoveDataI18nDir"
                                                  Directory="DataI18nDir"
                                                  On="uninstall" />
                                </Component>
                            </Directory>
                            <Directory Id="DataWordlistsDir" Name="wordlists">
                                <Component Id="DataWordlists"
                                           Guid="$(var.DataWordlistsComponentGuid)">
                                    <RegistryValue Root="HKCU"
                                                   Key="$(var.InstallRegKey)"
                                                   Name="DataWordlists"
                                                   Type="integer"
                                                   Value="1"
                                                   KeyPath="yes" />
                                    <!-- FSTs (built from data/wordlists/<stem>.txt.gz). -->
                                    <File Id="FstEnUs"
                                          Source="$(var.DataDir)\wordlists\en_us.fst"
                                          Name="en_us.fst" />
                                    <File Id="FstUkUa"
                                          Source="$(var.DataDir)\wordlists\uk_ua.fst"
                                          Name="uk_ua.fst" />
                                    <File Id="FstRuRu"
                                          Source="$(var.DataDir)\wordlists\ru_ru.fst"
                                          Name="ru_ru.fst" />
                                    <File Id="FstDeDe"
                                          Source="$(var.DataDir)\wordlists\de_de.fst"
                                          Name="de_de.fst" />
                                    <File Id="FstEsEs"
                                          Source="$(var.DataDir)\wordlists\es_es.fst"
                                          Name="es_es.fst" />
                                    <File Id="FstFrFr"
                                          Source="$(var.DataDir)\wordlists\fr_fr.fst"
                                          Name="fr_fr.fst" />
                                    <File Id="FstPlPl"
                                          Source="$(var.DataDir)\wordlists\pl_pl.fst"
                                          Name="pl_pl.fst" />
                                    <File Id="FstCsCz"
                                          Source="$(var.DataDir)\wordlists\cs_cz.fst"
                                          Name="cs_cz.fst" />
                                    <File Id="FstElGr"
                                          Source="$(var.DataDir)\wordlists\el_gr.fst"
                                          Name="el_gr.fst" />
                                    <File Id="FstHeIl"
                                          Source="$(var.DataDir)\wordlists\he_il.fst"
                                          Name="he_il.fst" />
                                    <File Id="FstTrTr"
                                          Source="$(var.DataDir)\wordlists\tr_tr.fst"
                                          Name="tr_tr.fst" />
                                    <File Id="FstBgBg"
                                          Source="$(var.DataDir)\wordlists\bg_bg.fst"
                                          Name="bg_bg.fst" />
                                    <File Id="FstItIt"
                                          Source="$(var.DataDir)\wordlists\it_it.fst"
                                          Name="it_it.fst" />
                                    <File Id="FstPtPt"
                                          Source="$(var.DataDir)\wordlists\pt_pt.fst"
                                          Name="pt_pt.fst" />
                                    <File Id="FstPtBr"
                                          Source="$(var.DataDir)\wordlists\pt_br.fst"
                                          Name="pt_br.fst" />
                                    <!-- Curated 1-/2-letter stop-word lists. -->
                                    <File Id="StopEnUs"
                                          Source="$(var.DataDir)\wordlists\en_us-stop.txt"
                                          Name="en_us-stop.txt" />
                                    <File Id="StopUkUa"
                                          Source="$(var.DataDir)\wordlists\uk_ua-stop.txt"
                                          Name="uk_ua-stop.txt" />
                                    <File Id="StopRuRu"
                                          Source="$(var.DataDir)\wordlists\ru_ru-stop.txt"
                                          Name="ru_ru-stop.txt" />
                                    <File Id="StopDeDe"
                                          Source="$(var.DataDir)\wordlists\de_de-stop.txt"
                                          Name="de_de-stop.txt" />
                                    <File Id="StopEsEs"
                                          Source="$(var.DataDir)\wordlists\es_es-stop.txt"
                                          Name="es_es-stop.txt" />
                                    <File Id="StopFrFr"
                                          Source="$(var.DataDir)\wordlists\fr_fr-stop.txt"
                                          Name="fr_fr-stop.txt" />
                                    <File Id="StopPlPl"
                                          Source="$(var.DataDir)\wordlists\pl_pl-stop.txt"
                                          Name="pl_pl-stop.txt" />
                                    <File Id="StopCsCz"
                                          Source="$(var.DataDir)\wordlists\cs_cz-stop.txt"
                                          Name="cs_cz-stop.txt" />
                                    <File Id="StopElGr"
                                          Source="$(var.DataDir)\wordlists\el_gr-stop.txt"
                                          Name="el_gr-stop.txt" />
                                    <File Id="StopHeIl"
                                          Source="$(var.DataDir)\wordlists\he_il-stop.txt"
                                          Name="he_il-stop.txt" />
                                    <File Id="StopTrTr"
                                          Source="$(var.DataDir)\wordlists\tr_tr-stop.txt"
                                          Name="tr_tr-stop.txt" />
                                    <File Id="StopBgBg"
                                          Source="$(var.DataDir)\wordlists\bg_bg-stop.txt"
                                          Name="bg_bg-stop.txt" />
                                    <File Id="StopItIt"
                                          Source="$(var.DataDir)\wordlists\it_it-stop.txt"
                                          Name="it_it-stop.txt" />
                                    <File Id="StopPtPt"
                                          Source="$(var.DataDir)\wordlists\pt_pt-stop.txt"
                                          Name="pt_pt-stop.txt" />
                                    <File Id="StopPtBr"
                                          Source="$(var.DataDir)\wordlists\pt_br-stop.txt"
                                          Name="pt_br-stop.txt" />
                                    <!-- Surface-form FSTs (suggestions engine —
                                         apostrophes/hyphens preserved). -->
                                    <File Id="SurfaceEnUs"
                                          Source="$(var.DataDir)\wordlists\en_us-surface.fst"
                                          Name="en_us-surface.fst" />
                                    <File Id="SurfaceUkUa"
                                          Source="$(var.DataDir)\wordlists\uk_ua-surface.fst"
                                          Name="uk_ua-surface.fst" />
                                    <File Id="SurfaceRuRu"
                                          Source="$(var.DataDir)\wordlists\ru_ru-surface.fst"
                                          Name="ru_ru-surface.fst" />
                                    <File Id="SurfaceDeDe"
                                          Source="$(var.DataDir)\wordlists\de_de-surface.fst"
                                          Name="de_de-surface.fst" />
                                    <File Id="SurfaceEsEs"
                                          Source="$(var.DataDir)\wordlists\es_es-surface.fst"
                                          Name="es_es-surface.fst" />
                                    <File Id="SurfaceFrFr"
                                          Source="$(var.DataDir)\wordlists\fr_fr-surface.fst"
                                          Name="fr_fr-surface.fst" />
                                    <File Id="SurfacePlPl"
                                          Source="$(var.DataDir)\wordlists\pl_pl-surface.fst"
                                          Name="pl_pl-surface.fst" />
                                    <File Id="SurfaceCsCz"
                                          Source="$(var.DataDir)\wordlists\cs_cz-surface.fst"
                                          Name="cs_cz-surface.fst" />
                                    <File Id="SurfaceElGr"
                                          Source="$(var.DataDir)\wordlists\el_gr-surface.fst"
                                          Name="el_gr-surface.fst" />
                                    <File Id="SurfaceHeIl"
                                          Source="$(var.DataDir)\wordlists\he_il-surface.fst"
                                          Name="he_il-surface.fst" />
                                    <File Id="SurfaceTrTr"
                                          Source="$(var.DataDir)\wordlists\tr_tr-surface.fst"
                                          Name="tr_tr-surface.fst" />
                                    <File Id="SurfaceBgBg"
                                          Source="$(var.DataDir)\wordlists\bg_bg-surface.fst"
                                          Name="bg_bg-surface.fst" />
                                    <File Id="SurfaceItIt"
                                          Source="$(var.DataDir)\wordlists\it_it-surface.fst"
                                          Name="it_it-surface.fst" />
                                    <File Id="SurfacePtPt"
                                          Source="$(var.DataDir)\wordlists\pt_pt-surface.fst"
                                          Name="pt_pt-surface.fst" />
                                    <File Id="SurfacePtBr"
                                          Source="$(var.DataDir)\wordlists\pt_br-surface.fst"
                                          Name="pt_br-surface.fst" />
                                    <!-- Curated weak-word lists. WiX errors on absent
                                         Source files, so entries track the files that
                                         actually exist in data/wordlists/ — today only
                                         uk_ua ships one. (Fixes the weak list silently
                                         missing from Windows installs since it landed;
                                         the runtime treats a missing file as empty.) -->
                                    <File Id="WeakUkUa"
                                          Source="$(var.DataDir)\wordlists\uk_ua-weak.txt"
                                          Name="uk_ua-weak.txt" />
                                    <RemoveFolder Id="RemoveDataWordlistsDir"
                                                  Directory="DataWordlistsDir"
                                                  On="uninstall" />
                                </Component>
                            </Directory>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
            </Directory>
        </Directory>

        <ComponentGroup Id="MainComponents" Directory="APPLICATIONROOTFOLDER">
            <!--
                MainExecutable bundles the .exe AND the start-menu
                shortcut. Putting them together avoids ICE69 (shortcut
                whose Target refers to a file in another component) and
                keeps cleanup atomic — uninstalling the binary
                automatically removes its shortcut and the start-menu
                folder.

                The data folder cleanup (`data/`, `data/layout-mappings/`,
                `data/wordlists/`) is handled inside the data Components
                themselves via `RemoveFolder`. The root `data/` folder
                gets cleaned up when the parent `APPLICATIONROOTFOLDER`
                is removed below.
            -->
            <Component Id="MainExecutable" Guid="$(var.MainExecutableComponentGuid)">
                <File Id="ExeFile"
                      Source="$(var.BinPath)"
                      Name="poltertype.exe" />
                <!--
                    Non-advertised shortcut. `Advertise="yes"` requires
                    the component's KeyPath to be a `File`, but ours is
                    a `RegistryValue` (forced by ICE38 for perUser).
                    `Target="[#ExeFile]"` is fine because `ExeFile` is
                    in *this* same component, so ICE69 (cross-component
                    shortcut target) doesn't fire either.
                -->
                <Shortcut Id="StartMenuLink"
                          Directory="ApplicationProgramsFolder"
                          Name="$(var.ProductName)"
                          Description="Cross-platform automatic keyboard layout switcher"
                          Target="[#ExeFile]"
                          WorkingDirectory="APPLICATIONROOTFOLDER" />
                <RemoveFolder Id="RemoveAppProgramsFolder"
                              Directory="ApplicationProgramsFolder"
                              On="uninstall" />
                <RemoveFolder Id="RemoveDataDir"
                              Directory="DataDir"
                              On="uninstall" />
                <RemoveFolder Id="RemoveAppRootFolder"
                              Directory="APPLICATIONROOTFOLDER"
                              On="uninstall" />
                <RemoveFolder Id="RemoveManufacturerFolder"
                              Directory="ManufacturerFolder"
                              On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="$(var.InstallRegKey)"
                               Name="MainExecutable"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
            <Component Id="LicenseFile" Guid="$(var.LicenseFileComponentGuid)">
                <File Id="LicenseTxt"
                      Source="$(var.LicensePath)"
                      Name="LICENSE" />
                <RegistryValue Root="HKCU"
                               Key="$(var.InstallRegKey)"
                               Name="LicenseFile"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Product>
</Wix>
