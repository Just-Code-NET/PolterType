# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Rust / Cargo ---
target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# --- Local config / secrets ---
.env
.env.*
!.env.example

# --- Local-only assistant notes, never committed ---
# (per-developer notes are excluded globally, not here — nothing about a
#  developer's own tooling belongs in a public repository)
.claude/

# --- Logs / coverage ---
*.log
coverage/
*.lcov

# --- Local AI model files (large, not source) ---
models/
*.onnx
*.gguf
*.safetensors

# --- Wordlist source archives (re-fetched via xtask, not source-of-truth) ---
data/wordlists/sources/

